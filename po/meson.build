# Two things xgettext has to be told about. `translatable` marks strings written
# down before there is a window to show them in; `pgettext` says which sense of a
# word is meant, and its first argument is that context rather than the text.
i18n.gettext(
  gettext_package,
  preset: 'glib',
  args: [
    '--keyword=translatable',
    '--keyword=pgettext:1c,2',
  ],
)
