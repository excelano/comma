<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.excelano.Comma</id>

  <name>Comma</name>
  <summary>Edit delimited text files</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Comma is a small editor for CSV, TSV, and other delimited text files. It
      shows a file as a grid of values and saves it back as the same kind of
      file it opened, leaving every row you did not edit byte for byte as it
      was.
    </p>
    <p>
      Values are treated as text and never reinterpreted, so leading zeros
      survive, long identifiers stay whole, and dates are whatever the file
      says they are.
    </p>
    <p>
      Comma is not a spreadsheet. There are no formulas, no cell formatting,
      and no second file format to save into.
    </p>
  </description>

  <launchable type="desktop-id">com.excelano.Comma.desktop</launchable>

  <developer id="com.excelano">
    <name>David M. Anderson</name>
  </developer>

  <url type="homepage">https://github.com/excelano/comma</url>
  <url type="bugtracker">https://github.com/excelano/comma/issues</url>
  <url type="vcs-browser">https://github.com/excelano/comma</url>

  <!-- Fetched by Flathub at build time and mirrored, so these have to stay
       where they are. Taken at 1600x900 against a made-up order book, which is
       the shape of file Comma is for: identifiers with leading zeros, part
       numbers too long for a spreadsheet to leave alone, and dates that are
       whatever the file says. -->
  <screenshots>
    <screenshot type="default">
      <caption>A delimited file as a grid, with every value left as the file wrote it</caption>
      <image>https://raw.githubusercontent.com/excelano/comma/main/data/screenshots/grid.png</image>
    </screenshot>
    <screenshot>
      <caption>A column held to a condition, and a count of what is showing</caption>
      <image>https://raw.githubusercontent.com/excelano/comma/main/data/screenshots/filters.png</image>
    </screenshot>
    <screenshot>
      <caption>The same file on a dark desktop</caption>
      <image>https://raw.githubusercontent.com/excelano/comma/main/data/screenshots/grid-dark.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <!-- The wash GNOME Software and Flathub paint behind the icon. Both are
       taken from the icon itself rather than from the brand sheet: the deep
       purple is the shade already in the mark, and the light one is that hue
       lifted until dark text sits on it comfortably. -->
  <branding>
    <color type="primary" scheme_preference="light">#d7c8ec</color>
    <color type="primary" scheme_preference="dark">#3f1d6b</color>
  </branding>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <releases>
    <release version="0.1.13" date="2026-08-26">
      <description>
        <p>
          A file with line breaks inside its values no longer stops drawing.
          Scrolling down one could leave the window frozen with everything
          behind it still running, on any file long enough to scroll where the
          rows are not all the same height.
        </p>
        <p>
          The number beside a row is that row's line in the file again. On those
          same files the numbers used to drift out of step with the rows the
          further you scrolled, so that a row could be drawn beside a number
          several rows from its own. They are now drawn against the rows
          themselves rather than counted separately.
        </p>
      </description>
    </release>
    <release version="0.1.12" date="2026-08-15">
      <description>
        <p>
          The last column can be made wider or narrower like every other one.
          Its right edge answers to a drag from either side of the line, where
          before it was the one edge in the table that answered to nothing.
        </p>
        <p>
          Resizing a column no longer moves the keyboard. Taking hold of a
          column used to put the cursor on a cell, and the cursor is what
          decides which row or column the next insert or delete happens to. It
          now stays where you left it.
        </p>
      </description>
    </release>
    <release version="0.1.11" date="2026-08-14">
      <description>
        <p>
          The files you have had open are a click away. The arrow beside Open
          lists them, newest first, with a box to search through them when the
          list is long. Clicking one opens it here, and asks first if there is
          anything unsaved in the window.
        </p>
        <p>
          Comma also puts the files it opens into the desktop's own recent
          documents now, so a file edited here turns up in the Files sidebar
          and wherever else your desktop lists what you have been working on.
          Saving under a new name files that name as well.
        </p>
        <p>
          A file opened from a share or a server says which folder it is in,
          where before it said nothing.
        </p>
      </description>
    </release>
    <release version="0.1.10" date="2026-08-14">
      <description>
        <p>
          Comma can open a second window. A button at the left of the header
          bar, or Ctrl+N, gives you an empty one to open another file in, which
          until now took naming both files on the command line or quitting
          Comma first. Ctrl+W closes the window you are in, and asks before
          it goes if there is anything unsaved in it.
        </p>
        <p>
          Saving a file under another name, and writing one out as a PDF, a
          web page or a spreadsheet, have moved out of the main menu to the
          arrow beside the Save button, a click from the button they belong
          to.
        </p>
        <p>
          The exports no longer offer themselves on a window with no file
          open.
        </p>
      </description>
    </release>
    <release version="0.1.9" date="2026-08-14">
      <description>
        <p>
          Comma now guesses whether the first row of a file is column titles or
          data, the way it already guessed the delimiter. A column of figures
          with a word over it has a title on it; a column that runs figures all
          the way to the top does not.
        </p>
        <p>
          Both guesses sit under the header bar button that says how the file
          is being read, and both are one click from being corrected.
          Correcting this one settles it: changing the delimiter afterwards
          makes the guess again only while it is still a guess, and never
          overrules an answer you gave.
        </p>
      </description>
    </release>
    <release version="0.1.8" date="2026-08-13">
      <description>
        <p>
          Comma can now hand the file, or the folder it sits in, to something
          else. The primary menu opens the containing folder, or a terminal
          already standing in it, so there is no path to retype.
        </p>
        <p>
          It can also open the file in xled, xql or nved, each offered only
          when it is installed. Comma tells them what it has already worked out
          about the file — which delimiter it is reading and whether the first
          row is a header — so the tool comes up on the same view of the file
          rather than working it out again.
        </p>
        <p>
          A file with unsaved edits offers to save before it is handed over,
          since the tool reads what is on disk.
        </p>
      </description>
    </release>
    <release version="0.1.7" date="2026-08-12">
      <description>
        <p>
          Comma now notices when something else writes the file it has open. If
          nothing is unsaved it reads the file again and says so; if there are
          edits to lose, or a cell is open for typing, it says the file has
          changed and waits to be asked.
        </p>
        <p>
          Saving over a file that has been written to since Comma read it now
          asks first, and offers to save this version somewhere else instead.
        </p>
        <p>
          Reading the file again keeps the sorting, the column conditions, how
          far across the file you had scrolled and the row you were on.
        </p>
      </description>
    </release>
    <release version="0.1.6" date="2026-08-12">
      <description>
        <p>
          Fixes a fault that could make Comma stop responding after a cell had
          been opened for typing. Every version before this one is affected, so
          this is worth updating to.
        </p>
      </description>
    </release>
    <release version="0.1.5" date="2026-08-12">
      <description>
        <p>
          Clicking a row number now moves the keyboard there even in the moment
          after a filter or a search has changed what is showing, rather than
          quietly doing nothing.
        </p>
        <p>
          Tabbing through the window goes from the toolbar straight into the
          table. It used to stop at the row numbers, which answer to the mouse
          and had no key to press.
        </p>
      </description>
    </release>
    <release version="0.1.4" date="2026-08-12">
      <description>
        <p>
          Any column can be held to a condition of its own. Right-click its
          heading and pick from nine: contains and does not contain, is and is
          not, is empty and is not empty, is greater than, is less than, and is
          between. Several columns can each carry one, and they narrow one
          another.
        </p>
        <p>
          Right-clicking a cell offers the shortest way in — hold this column to
          the value already written here. Numbers are read as numbers, so a
          price above 100 turns up neither a blank cell nor one priced in
          sterling.
        </p>
        <p>
          Every condition in force is spelled out on a bar under the toolbar
          with the button that removes it, and the title now says how many rows
          of how many are showing, whether a filter or a search is what left
          them out.
        </p>
      </description>
    </release>
    <release version="0.1.3" date="2026-08-11">
      <description>
        <p>
          Wide files draw faster. A file of forty-odd columns took about a
          second to put its table on the screen and now takes around half of
          that, because the height of a line of text is measured once for the
          whole grid rather than again for every cell in it.
        </p>
        <p>
          Building Comma from source now gives you an optimised binary.
          Asking Meson for one had quietly been giving you the opposite.
        </p>
      </description>
    </release>
    <release version="0.1.2" date="2026-08-11">
      <description>
        <p>
          The row numbers stay put when the grid is scrolled sideways, as the
          column headings already did, so the number naming a row is beside it
          however far across a wide file you have gone.
        </p>
        <p>
          A row inserted mid-file no longer misnumbers the rows below it, and
          an edit made to one of those rows is written to the row you typed
          into rather than to the one above it.
        </p>
      </description>
    </release>
    <release version="0.1.1" date="2026-08-10">
      <description>
        <p>
          Files open quickly. A cell now builds its editor when you type in
          it rather than when the grid is drawn, so a file of four thousand
          rows opens in a moment rather than in a couple of seconds, and a
          wide file gains the most.
        </p>
        <p>
          Inserting or deleting a row redraws that row rather than the whole
          grid, so the table stays where you had scrolled it to.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-10">
      <description>
        <p>
          The first release. Comma opens a delimited file, guesses its
          delimiter and says which one it guessed, and edits it as a grid.
          Rows and columns can be inserted and deleted, everything can be
          undone, and saving a file changes only the lines you edited.
        </p>
        <p>
          Sorting and searching are views of the file rather than changes to
          it, and one menu item writes a sort order down when you want it.
          What the grid is showing can be exported as a PDF, a web page, or an
          OpenDocument spreadsheet.
        </p>
      </description>
    </release>
  </releases>
</component>
