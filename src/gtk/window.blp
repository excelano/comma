using Gtk 4.0;
using Adw 1;

template $CommaWindow: Adw.ApplicationWindow {
  title: _("Comma");

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Comma");
      };

      [start]
      Button {
        label: _("_Open");
        use-underline: true;
        action-name: "win.open";
        tooltip-text: _("Open a File");
      }

      [start]
      Button {
        label: _("_Save");
        use-underline: true;
        action-name: "win.save";
        tooltip-text: _("Save This File");
      }

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }

      [end]
      ToggleButton {
        icon-name: "system-search-symbolic";
        tooltip-text: _("Find and Replace");
        action-name: "win.find";
      }

      [end]
      MenuButton dialect_button {
        visible: false;
        always-show-arrow: true;
        tooltip-text: _("How This File Is Read");
      }
    }

    [top]
    SearchBar search_bar {
      child: Box {
        orientation: horizontal;
        spacing: 6;

        SearchEntry search_entry {
          placeholder-text: _("Find");
          hexpand: true;
          width-chars: 12;
        }

        Entry replacement {
          placeholder-text: _("Replace With");
          hexpand: true;
          width-chars: 12;
        }

        Button {
          label: _("Replace _All");
          use-underline: true;
          action-name: "win.replace-all";
        }
      };
    }

    content: Stack stack {
      StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "com.excelano.Comma-symbolic";
          title: _("No File Open");
          description: _("Comma edits CSV, TSV, and other delimited text files.");

          child: Button {
            label: _("_Open File…");
            use-underline: true;
            action-name: "win.open";
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      StackPage {
        name: "grid";

        child: ScrolledWindow {
          hexpand: true;
          vexpand: true;

          child: ColumnView column_view {
            show-row-separators: true;
            show-column-separators: true;
            reorderable: false;
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Undo");
      action: "win.undo";
    }

    item {
      label: _("_Redo");
      action: "win.redo";
    }
  }

  section {
    item {
      label: _("Insert Row Above");
      action: "win.insert-row-above";
    }

    item {
      label: _("Insert Row Below");
      action: "win.insert-row-below";
    }

    item {
      label: _("Delete Row");
      action: "win.delete-row";
    }
  }

  section {
    item {
      label: _("Insert Column Before");
      action: "win.insert-column-before";
    }

    item {
      label: _("Insert Column After");
      action: "win.insert-column-after";
    }

    item {
      label: _("Delete Column");
      action: "win.delete-column";
    }
  }

  section {
    item {
      label: _("Apply This Order to the File");
      action: "win.commit-order";
    }
  }

  section {
    submenu {
      label: _("_Export");

      item {
        label: _("As PDF…");
        action: "win.export-pdf";
      }

      item {
        label: _("As Web Page…");
        action: "win.export-html";
      }

      item {
        label: _("As Spreadsheet…");
        action: "win.export-ods";
      }
    }
  }

  section {
    item {
      label: _("_Open…");
      action: "win.open";
    }

    item {
      label: _("_Save");
      action: "win.save";
    }

    item {
      label: _("Save _As…");
      action: "win.save-as";
    }
  }

  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "win.shortcuts";
    }

    item {
      label: _("_About Comma");
      action: "app.about";
    }
  }
}
