using Gtk 4.0;
using Adw 1;

template $CommaWindow: Adw.ApplicationWindow {
  title: _("Comma");

  // Outside the toolbar view rather than around the grid inside it. Wrapping
  // only the grid puts a layer between the table and the window, and on Wayland
  // a menu popped up over the table then floods the log with widget assertions
  // — hundreds a frame, until the machine gives out. Around the whole thing it
  // does not, and this is where GNOME apps put it anyway.
  content: Adw.ToastOverlay toasts {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle window_title {
          title: _("Comma");
        };

        // First, and an icon rather than a word, because it is the one control
        // here that is not about the file this window holds.
        [start]
        Button {
          icon-name: "document-new-symbolic";
          action-name: "app.new-window";
          tooltip-text: _("New Window");
        }

        // Pressing it asks where; the arrow beside it offers the files
        // already worked on, which is where the answer usually is.
        [start]
        Adw.SplitButton open_button {
          label: _("_Open");
          use-underline: true;
          action-name: "win.open";
          tooltip-text: _("Open a File");

          popover: Popover recents {
            child: Box {
              orientation: vertical;
              spacing: 6;
              width-request: 300;

              SearchEntry recent_search {
                placeholder-text: _("Search Recent Files");
              }

              ScrolledWindow {
                hscrollbar-policy: never;
                propagate-natural-height: true;
                max-content-height: 400;

                child: ListBox recent_list {
                  selection-mode: none;

                  [placeholder]
                  Label recents_message {
                    margin-top: 18;
                    margin-bottom: 18;
                    margin-start: 6;
                    margin-end: 6;
                    wrap: true;

                    styles [
                      "dim-label",
                    ]
                  }
                };
              }
            };
          };
        }

        // Pressing it saves; the arrow beside it holds the other ways of
        // writing the file out, which had been two levels down in the main
        // menu and are now one click from the button they belong to.
        [start]
        Adw.SplitButton save_button {
          label: _("_Save");
          use-underline: true;
          action-name: "win.save";
          tooltip-text: _("Save This File");
        }

        [end]
        MenuButton menu_button {
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
        }

        [end]
        ToggleButton {
          icon-name: "system-search-symbolic";
          tooltip-text: _("Find and Replace");
          action-name: "win.find";
        }

        [end]
        MenuButton dialect_button {
          visible: false;
          always-show-arrow: true;
          tooltip-text: _("How This File Is Read");
        }
      }

      // What the file on disk is doing that the grid is not. Hidden until it is
      // doing something.
      [top]
      Adw.Banner banner {
        revealed: false;
      }

      [top]
      SearchBar search_bar {
        child: Box {
          orientation: horizontal;
          spacing: 6;

          SearchEntry search_entry {
            placeholder-text: _("Find");
            hexpand: true;
            width-chars: 12;
          }

          Entry replacement {
            placeholder-text: _("Replace With");
            hexpand: true;
            width-chars: 12;
          }

          Button {
            label: _("Replace _All");
            use-underline: true;
            action-name: "win.replace-all";
          }
        };
      }

      [top]
      Box filter_bar {
        visible: false;
        orientation: horizontal;
        spacing: 6;

        styles [
          "toolbar",
        ]

        // A file with more filters than fit is a file you can still read them all
        // of, rather than one that silently shows you some of what is in force.
        ScrolledWindow {
          hexpand: true;
          vscrollbar-policy: never;
          propagate-natural-height: true;

          child: Box chips {
            orientation: horizontal;
            spacing: 6;
          };
        }

        Button {
          label: _("Clear _All");
          use-underline: true;
          action-name: "win.clear-filters";
          tooltip-text: _("Show Every Row Again");
        }
      }

      content: Stack stack {
        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "com.excelano.Comma-symbolic";
            title: _("No File Open");
            description: _("Comma edits CSV, TSV, and other delimited text files.");

            child: Button {
              label: _("_Open File…");
              use-underline: true;
              action-name: "win.open";
              halign: center;

              styles [
                "pill",
                "suggested-action",
              ]
            };
          };
        }

        StackPage {
          name: "grid";

          child: Box {
            orientation: vertical;

            // The numbers hold the table rather than sit beside it. They are
            // drawn against the rows the table has laid out, so they have to be
            // laid out after it, and a widget that owns the table is the only
            // way to be sure of the order.
            $CommaGutter gutter {
              vexpand: true;

              ScrolledWindow table {
                hexpand: true;
                hscrollbar-policy: external;

                child: ColumnView column_view {
                  show-row-separators: true;
                  show-column-separators: true;
                  reorderable: false;
                };
              }
            }

            Scrollbar across {
              orientation: horizontal;
            }
          };
        }
      };
    };
  };
}
