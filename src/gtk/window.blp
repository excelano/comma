using Gtk 4.0;
using Adw 1;

template $CommaWindow: Adw.ApplicationWindow {
  title: _("Comma");

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {
        title: _("Comma");
      };

      [start]
      Button {
        label: _("_Open");
        use-underline: true;
        action-name: "win.open";
        tooltip-text: _("Open a File");
      }

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }

      [end]
      MenuButton dialect_button {
        visible: false;
        always-show-arrow: true;
        tooltip-text: _("How This File Is Read");
      }
    }

    content: Stack stack {
      StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "com.excelano.Comma-symbolic";
          title: _("No File Open");
          description: _("Comma edits CSV, TSV, and other delimited text files.");

          child: Button {
            label: _("_Open File…");
            use-underline: true;
            action-name: "win.open";
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      StackPage {
        name: "grid";

        child: ScrolledWindow {
          hexpand: true;
          vexpand: true;

          child: ColumnView column_view {
            show-row-separators: true;
            show-column-separators: true;
            reorderable: false;
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Open…");
      action: "win.open";
    }
  }

  section {
    item {
      label: _("_About Comma");
      action: "app.about";
    }
  }
}
